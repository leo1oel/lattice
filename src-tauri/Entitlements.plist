<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements shared by Lattice and its bundled Synara Node runtime. -->
<plist version="1.0">
  <dict>
    <!-- Voice notes are recorded by the embedded agent panel through WKWebView.
         Hardened Runtime blocks getUserMedia without this capability even when
         NSMicrophoneUsageDescription is present in the application bundle. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Synara loads packaged native Node addons from its application resource
         directory. They are signed during release packaging. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The packaged Node/V8 runtime needs JIT under Hardened Runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
