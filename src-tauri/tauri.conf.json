{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattice",
  "version": "0.1.285",
  "identifier": "app.leo1oel.researchwriter",
  "build": {
    "beforeDevCommand": "pnpm prepare:runtime:dev && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm prepare:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "create": false,
        "title": "Lattice",
        "width": 1440,
        "height": 900,
        "minWidth": 1222,
        "minHeight": 680,
        "backgroundColor": "#F7F7F6",
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'none'"],
        "script-src": ["'self'", "'unsafe-inline'", "https:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:", "http:", "https:"],
        "font-src": ["'self'", "data:"],
        "media-src": ["'self'", "data:", "blob:", "http:", "https:"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "http:", "https:", "ws:", "wss:", "blob:"],
        "worker-src": ["'self'", "blob:"],
        "frame-src": ["'self'", "http:", "https:"],
        "child-src": ["'self'", "blob:", "http:", "https:"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'none'"],
        "script-src": ["'self'", "'unsafe-inline'", "https:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:", "http:", "https:"],
        "font-src": ["'self'", "data:"],
        "media-src": ["'self'", "data:", "blob:", "http:", "https:"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "http:", "https:", "ws:", "wss:", "blob:"],
        "worker-src": ["'self'", "blob:"],
        "frame-src": ["'self'", "http:", "https:"],
        "child-src": ["'self'", "blob:", "http:", "https:"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"]
      },
      "dangerousDisableAssetCspModification": ["script-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MkFFM0U0NkFFOEM4OTIKUldTU3lPaHE1T01xTlV4dUozZGVvRUhxcVpJREl1aVJsRkpiYVl4aWttcjJseENQTnBLSzI4VzgK",
      "endpoints": [
        "https://github.com/leo1oel/lattice/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "chromium-runtime/",
      "presentation-runtime/",
      "synara-runtime/**/*",
      "src/embedded_skills/"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
