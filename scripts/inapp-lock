#!/usr/bin/env python3
"""One in-app session at a time on this Mac: the GPUI e2e, perf, memcmp and
lab runs, in-app screenshots and recordings (docs/driving-the-app.md).

The lock is flock(2) on /tmp/lattice-inapp-test.lock, the file every crew tool
already locks (lockf -k, the e2e scripts, ci:local's probe). The file is never
deleted: plain lockf(1) without -k unlinks it on exit, after which the next
taker locks a new file while a waiter still holds the old one, and two
sessions run at once. A taker here also checks that the file it locked is
still the one at the path (its inode), and takes it again when not; a holder
checks the same every second and, when someone has replaced the file, locks
the new one too, or says loudly that it could not.

The holder writes who it is into the file (pid, thread, command, since), so a
waiter can say what it waits on, and `status` can tell a live holder from a
gone one. flock is released by the kernel when its holder dies, so a dead
holder never keeps the lock; when the recorded pid is gone and the lock is
still held, some other process holds it, and `status` names it from lsof.

`hold` detaches: it takes the lock in a process of its own session, apart
from the shell that ran it, and returns once that process holds it, so the
hold outlives the command or tool call that started it (a tool that ends its
command's process group would otherwise end the hold, and with it the lock).

Usage:
  inapp-lock [--thread CODE] [--wait SECONDS] -- COMMAND [ARGS...]
      Run COMMAND holding the lock, and release it when COMMAND exits (its
      exit status is this one's). --wait gives up after SECONDS with status 75
      (default: wait as long as it takes; 0 means try once).
  inapp-lock [--thread CODE] [--wait SECONDS] hold [SECONDS]
      Take the lock for a session of several commands and return once it is
      held; it is released after SECONDS (default 7200) or on `release`.
  inapp-lock [--thread CODE] release
      End this thread's hold (the one `hold` started under the same code).
  inapp-lock status
      Print whether the lock is held, and by whom. Status 0 free, 1 held.

The thread code defaults to $CAPY_THREAD, else "unknown".
"""

import fcntl
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time

LOCK = os.environ.get("INAPP_LOCK_FILE", "/tmp/lattice-inapp-test.lock")
TIMED_OUT = 75


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def holder():
    try:
        with open(LOCK) as file:
            return json.loads(file.read() or "null")
    except (OSError, ValueError):
        return None


def describe(record):
    if not record:
        return "a holder that did not say who it is (lockf or an older script)"
    state = "" if alive(record.get("pid", 0)) else ", whose pid is gone"
    return "{thread} (pid {pid}{state}, since {since}): {command}".format(state=state, **record)


def lockers():
    """The processes that have the lock file open, from lsof."""
    out = subprocess.run(["lsof", "-t", LOCK], capture_output=True, text=True).stdout
    return [int(pid) for pid in out.split()]


def held():
    fd = os.open(LOCK, os.O_RDONLY | os.O_CREAT, 0o666)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    finally:
        os.close(fd)
    return False


def lock_at_path():
    """The lock file at the path, flocked, or None while someone holds it."""
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o666)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    try:
        if os.stat(LOCK).st_ino == os.fstat(fd).st_ino:
            return fd
    except FileNotFoundError:
        pass
    os.close(fd)
    return lock_at_path()


def acquire(thread, command, wait, notes):
    """Take the lock and write the record, or return None after `wait` seconds."""
    started = time.monotonic()
    last_note = None
    while True:
        fd = lock_at_path()
        if fd is not None:
            break
        waited = time.monotonic() - started
        if wait is not None and waited >= wait:
            return None
        if last_note is None or waited - last_note >= 60:
            last_note = waited
            print(f"inapp-lock: waiting ({int(waited // 60)} min so far) for {describe(holder())}", file=notes, flush=True)
        time.sleep(1)
    record = {
        "pid": os.getpid(),
        "thread": thread,
        "host": socket.gethostname(),
        "since": time.strftime("%Y-%m-%d %H:%M:%S %Z"),
        "command": " ".join(command),
    }
    os.ftruncate(fd, 0)
    os.pwrite(fd, json.dumps(record).encode(), 0)
    keep_at_path(fd, record)
    return fd


def keep_at_path(fd, record):
    """Every second, check the path still names the file this one holds; when
    someone replaced it, lock the new file too so nobody else can, or warn."""
    held_fds = [fd]

    def watch():
        while True:
            time.sleep(1)
            try:
                current = os.stat(LOCK).st_ino
            except FileNotFoundError:
                current = None
            if current is not None and current == os.fstat(held_fds[-1]).st_ino:
                continue
            fresh = lock_at_path()
            if fresh is None:
                print(f"inapp-lock: WARNING someone replaced {LOCK} and {describe(holder())} took the new one; two sessions may now run at once", file=sys.stderr, flush=True)
                continue
            os.pwrite(fresh, json.dumps(record).encode(), 0)
            held_fds.append(fresh)

    threading.Thread(target=watch, daemon=True).start()


def release(fd):
    os.ftruncate(fd, 0)
    os.close(fd)


def run(thread, wait, command):
    fd = acquire(thread, command, wait, sys.stderr)
    if fd is None:
        print(f"inapp-lock: gave up after {wait:g} s; held by {describe(holder())}", file=sys.stderr)
        return TIMED_OUT
    print(f"inapp-lock: taken by {thread} (pid {os.getpid()})", file=sys.stderr, flush=True)
    try:
        # Its own process group, so a signal that ends this one ends the
        # whole run with it rather than leaving it on the screen unlocked.
        child = subprocess.Popen(command, start_new_session=True)

        # The group may be gone (ProcessLookupError), or hold only processes
        # this one may not signal, such as one that changed its user, or one
        # macOS still counts there while it exits (PermissionError). Neither
        # is a reason to fail the run or keep the lock.
        def forward(signum, _frame):
            try:
                os.killpg(child.pid, signum)
            except (ProcessLookupError, PermissionError):
                pass

        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, forward)
        status = child.wait()
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        except PermissionError:
            print(f"inapp-lock: could not end what is left of the run's process group {child.pid} (not permitted)", file=sys.stderr, flush=True)
        return status if status >= 0 else 128 - status
    finally:
        release(fd)


def hold(thread, wait, seconds):
    """Take the lock in a detached process; return once it holds it."""
    read_end, write_end = os.pipe()
    if os.fork():
        os.close(write_end)
        with os.fdopen(read_end) as notes:
            for line in notes:
                print(line, end="", file=sys.stderr, flush=True)
                if line.startswith("inapp-lock: taken"):
                    return 0
        return TIMED_OUT
    os.close(read_end)
    os.setsid()
    if os.fork():
        os._exit(0)
    notes = os.fdopen(write_end, "w")
    devnull = os.open(os.devnull, os.O_RDWR)
    for stream in (0, 1, 2):
        os.dup2(devnull, stream)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    fd = acquire(thread, [f"hold {int(seconds)} s"], wait, notes)
    if fd is None:
        print(f"inapp-lock: gave up after {wait:g} s; held by {describe(holder())}", file=notes, flush=True)
        os._exit(TIMED_OUT)
    print(f"inapp-lock: taken by {thread} (pid {os.getpid()}) for up to {int(seconds)} s; release with: inapp-lock --thread {thread} release", file=notes, flush=True)
    notes.close()
    signal.signal(signal.SIGTERM, lambda *_: (release(fd), os._exit(0)))
    time.sleep(seconds)
    release(fd)
    os._exit(0)


def release_hold(thread):
    record = holder()
    if not record or record.get("thread") != thread or not str(record.get("command", "")).startswith("hold "):
        print(f"inapp-lock: {thread} holds no lock; held by {describe(record)}" if held() else "inapp-lock: free", file=sys.stderr)
        return 1
    os.kill(record["pid"], signal.SIGTERM)
    for _ in range(50):
        if not alive(record["pid"]):
            print(f"inapp-lock: released {thread}'s hold", file=sys.stderr)
            return 0
        time.sleep(0.1)
    print(f"inapp-lock: pid {record['pid']} did not end", file=sys.stderr)
    return 1


def main(argv):
    thread = os.environ.get("CAPY_THREAD") or "unknown"
    wait = None
    while argv and argv[0].startswith("--") and argv[0] != "--":
        flag = argv.pop(0)
        if flag == "--thread" and argv:
            thread = argv.pop(0)
        elif flag == "--wait" and argv:
            wait = float(argv.pop(0))
        else:
            sys.exit(f"inapp-lock: unknown option {flag}\n{__doc__}")
    if argv and argv[0] == "--":
        return run(thread, wait, argv[1:]) if len(argv) > 1 else sys.exit(__doc__)
    if argv == ["status"]:
        if not held():
            print("inapp-lock: free")
            return 0
        record = holder()
        print(f"inapp-lock: held by {describe(record)}")
        if not record or not alive(record.get("pid", 0)):
            print(f"inapp-lock: the lock file is open in pids {lockers()}; one of them holds it")
        return 1
    if argv and argv[0] == "hold" and len(argv) <= 2:
        return hold(thread, wait, float(argv[1]) if len(argv) == 2 else 7200.0)
    if argv == ["release"]:
        return release_hold(thread)
    if argv:
        return run(thread, wait, argv)
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
