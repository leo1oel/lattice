# Copy to `.env.local` (gitignored) and fill in what you need. Every variable
# here is optional: Lattice builds and runs with all of them unset.
#
# `VITE_`-prefixed values are read by the frontend and are baked into the
# JavaScript bundle at build time, so treat them as public. The plain variables
# further down are read by build tooling or by the Rust process, never by the
# bundle — and Vite only loads `.env.local` for the frontend, so those must be
# exported in your shell (or set as CI secrets) to have any effect. They are
# listed here anyway because this is where people look for them.

# ---------------------------------------------------------------------------
# Frontend (baked into the bundle — public)
# ---------------------------------------------------------------------------

# tldraw license key for the board editor (client-side, safe to embed).
# Without it the board falls back to tldraw's watermarked mode.
# Read by: src/editor/board/board-editor.tsx. Get yours at
# https://tldraw.dev/sdk-features/license-key
VITE_TLDRAW_LICENSE_KEY=

# Origin of an already-running Synara agent runtime to embed, instead of
# letting the app supervise the bundled sidecar. Useful when developing against
# a Synara checkout you start yourself.
#
# Read by BOTH halves, and they do not read it from the same place:
#   - src/agent/use-synara-runtime.ts reads it from the bundle, so `.env.local` is
#     enough for `pnpm dev`;
#   - src-tauri/src/synara.rs reads it from the process environment, and only
#     in debug builds. `.env.local` never reaches the Rust process, so for
#     `pnpm tauri dev` — the half that actually skips supervising the sidecar —
#     export it in the shell you launch from.
#
# VITE_SYNARA_EMBED_URL=http://127.0.0.1:4567
VITE_SYNARA_EMBED_URL=

# ---------------------------------------------------------------------------
# Build-time only (plain shell variables, NOT part of the frontend bundle)
# ---------------------------------------------------------------------------

# Where to find the pinned Synara source when staging the agent sidecar.
# Read by: scripts/prepare-synara-sidecar.mjs (and .github/workflows/release.yml
# sets it in CI). Defaults to the `sourceDirectory` in
# scripts/synara-runtime.json, resolved relative to the repository root.
# Most contributors do not need this at all — see CONTRIBUTING.md.
#
# SYNARA_SOURCE_DIR=/absolute/path/to/synara

# Firecrawl API key for webpage imports. Read by src-tauri/src/literature_credentials.rs,
# which prefers the process environment at runtime and otherwise falls back to
# a key compiled in with option_env! at build time (declared in
# src-tauri/build.rs). Official releases bake in a shared key from a repo
# secret; builds without one tell the user to set this variable when they try
# to import a webpage. Note this is a plain process variable, not a Vite one:
# `.env.local` does not reach the Rust process, so export it in your shell.
#
# LATTICE_FIRECRAWL_KEY=

# ---------------------------------------------------------------------------
# Read by the Rust process at runtime (export in your shell)
# ---------------------------------------------------------------------------

# Literature credentials: prefer Settings > Integrations > Literature services
# for personal keys stored in the system keychain. Saved values override these
# runtime environment values; without either, supported requests use the
# maintainer's public literature proxy and its shared limits. It receives paper
# search terms and identifiers, not project files. No maintainer key is bundled.
# Operator setup and secret rotation: docs/public-literature-service.md.
# Used by both native
# literature requests and the bibcite subprocess. OpenAlex uses a Bearer header
# in native requests; Semantic Scholar uses x-api-key. BIBCITE_MAILTO is an
# optional real contact email for Crossref's polite pool, not an API key.
# Export these in your shell: `.env.local` never reaches the Rust process.
#
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# S2_API_KEY= # legacy alias; SEMANTIC_SCHOLAR_API_KEY takes precedence
# BIBCITE_MAILTO=

# Project folder to open in the first window at launch. Read by:
# src-tauri/src/app_state.rs (AppState::from_environment). Must be an existing
# directory; it is canonicalized and bound to the main window only — windows
# opened later are told their project explicitly. Handy for launching the dev
# build straight into a fixture project.
#
# LATTICE_PROJECT=/absolute/path/to/a/project

# Project root for the `literature` CLI subcommand. Read by:
# src-tauri/src/agent_literature.rs (run_cli). The Lattice binary doubles as the backend for
# the agent's literature tools — `lattice literature '<json>'` — and that path
# exits with status 2 if this is unset. It has no effect on the desktop app;
# the agent gateway sets it per invocation.
#
# LATTICE_PROJECT_ROOT=/absolute/path/to/a/project

# ---------------------------------------------------------------------------
# Developer escape hatches (not needed for normal work)
# ---------------------------------------------------------------------------

# Run a local checkout of one of the Python literature CLIs instead of the
# uvx-provisioned pinned release. Read by: src-tauri/src/commands/python_tools.rs (UvTool).
# Opt-in by design — resolving these from PATH is exactly the accident that
# made the app behave differently on different machines.
#
# LATTICE_BIBCITE_BIN=/absolute/path/to/bibcite
# LATTICE_ARXIV2MD_BIN=/absolute/path/to/arxiv2md

# Inputs to the `#[ignore]`d Overleaf end-to-end Rust tests, which talk to the
# real overleaf.com with the session the app already stored. Read by:
# `live_project` in src-tauri/src/overleaf_rt/tests.rs. `..._PROJECT` is
# a linked project root on disk, `..._DOC` a document inside it the test types
# one character into and deletes again, and `..._CONFIG` an alternate app
# support directory to read the stored session from (it defaults to Lattice's
# own). Nothing in `pnpm check` runs these tests.
#
# OVERLEAF_E2E_PROJECT=/absolute/path/to/a/synced/overleaf/project
# OVERLEAF_E2E_DOC=main.tex
# OVERLEAF_E2E_CONFIG=/absolute/path/to/app-support-dir
