  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/app-size-report.mjs --check && pnpm size:test",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict",
    "i18n:guard": "node scripts/check-i18n-coverage.mjs",
    "i18n:check": "pnpm i18n:extract && git diff --exit-code -- src/locales && pnpm i18n:compile && pnpm i18n:guard",
    "prepare:synara": "node scripts/prepare-synara-sidecar.mjs",
    "prepare:synara:dev": "node scripts/prepare-synara-sidecar.mjs --allow-dirty",
    "prepare:chromium": "node scripts/prepare-chromium-runtime.mjs --synara-node-runtime=electron",
    "prepare:chromium:debug": "node scripts/prepare-chromium-runtime.mjs --synara-node-runtime=standalone",
    "prepare:presentation": "node scripts/prepare-presentation-runtime.mjs && node scripts/sign-presentation-runtime.mjs",
    "prepare:runtime": "pnpm prepare:synara && pnpm prepare:presentation",
    "prepare:runtime:dev": "pnpm prepare:synara:dev && pnpm prepare:presentation",
    "prepare:build": "node scripts/prepare-build.mjs",
    "check": "mise run check",
    "lint": "eslint src tools --max-warnings 117",
    "knip": "knip",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "collab:dev": "pnpm --dir collab-server run dev",
    "collab:deploy": "pnpm --dir collab-server run deploy",
    "collab:login": "pnpm --dir collab-server run login",
    "verify:overleaf": "node scripts/verify-overleaf.mjs",
    "eval:agent": "node scripts/agent-quality-eval.mjs",
    "size:report": "node scripts/app-size-report.mjs",
    "size:test": "node scripts/app-size-report-selftest.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check --allow-unresolved",
    "chromium": "electron scripts/chromium-shell.mjs"
  },
