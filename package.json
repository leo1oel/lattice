{
  "name": "research-writer",
  "private": true,
  "version": "0.1.180",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare:synara": "node scripts/prepare-synara-sidecar.mjs",
    "prepare:synara:dev": "node scripts/prepare-synara-sidecar.mjs --allow-dirty",
    "prepare:runtime": "pnpm prepare:synara",
    "prepare:runtime:dev": "pnpm prepare:synara:dev",
    "check": "pnpm lint && pnpm test && pnpm build && cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint": "eslint src --max-warnings 113",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "collab:dev": "pnpm --dir collab-server run dev",
    "collab:deploy": "pnpm --dir collab-server run deploy",
    "collab:login": "pnpm --dir collab-server run login",
    "verify:overleaf": "node scripts/verify-overleaf.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "1.0.0-beta.6",
    "@replit/codemirror-emacs": "^6.1.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-lang-latex": "^0.4.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "harper.js": "^2.7.0",
    "katex": "^0.18.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "motion": "^12.42.2",
    "pdfjs-dist": "^6.1.200",
    "radix-ui": "^1.6.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "y-codemirror.next": "^0.3.5",
    "y-partyserver": "^2.2.0",
    "y-protocols": "1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun": "1.3.14",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "interface-kit": "^0.1.3",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
