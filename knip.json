{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // `src/main.tsx` is not listed: knip's vite plugin already derives it from the
  // `<script type="module">` in index.html. `tools/icon-lab/main.tsx` is listed
  // because it is the entry of the dev-only playground shell (icon-lab.html),
  // which is deliberately not a build input, so nothing knip reads points at it.
  "entry": [
    "tools/icon-lab/main.tsx",
    "scripts/*.mjs",
    "lingui.config.ts"
  ],
  "project": ["src/**", "scripts/**", "protocol/**", "tools/**"],
  // collab-server/ is a separate workspace with its own package.json and is not
  // in `project`, so knip cannot see it. The cost of skipping it: it is the only
  // consumer of most of `protocol/**`, so anything exported there and used only
  // by the worker looks unused here. Verify protocol/ hits by hand against
  // collab-server/ before deleting them.
  //
  // The two open-knowledge trees are vendored upstream code. Their export
  // surface is upstream's public API, not our dead code, so knip flags ~330
  // symbols there that are neither bugs nor safe to delete: re-vendoring
  // restores anything removed. The lever that actually works is the file list
  // in scripts/vendor-open-knowledge.mjs, not this config.
  "ignore": [
    "collab-server/**",
    "src/open-knowledge-app/**",
    "src/open-knowledge-core/**"
  ],
  "ignoreDependencies": ["mdast-util-mdx-expression", "mdast-util-mdx-jsx"],
  // `pnpm check` shells out to mise, which is a system tool installed outside
  // the package manager (see CLAUDE.md), not a missing dependency. `typecheck`
  // is knip misreading `pnpm --dir collab-server typecheck` in ci.yml as a
  // binary; it is a package script in that workspace.
  "ignoreBinaries": ["mise", "typecheck"],
  // Scoped to the findings that are actionable and currently near zero, so a
  // red `pnpm knip` means something. Export-level analysis is excluded on
  // purpose: it reports first-party symbols that are exported but used only
  // inside their own file. Those are worth cleaning up — dropping the `export`
  // hands them to tsc's `noUnusedLocals`, which polices them forever — but they
  // are not defects. Audit them deliberately with:
  //   pnpm knip --include exports,types,duplicates
  // Account for deliberate shadcn barrel re-exports in src/components/ui/
  // and the protocol/collab-v2.ts wire contract consumed by collab-server/
  // before treating export-level findings as dead code.
  "exclude": ["exports", "types", "nsExports", "nsTypes"]
}
