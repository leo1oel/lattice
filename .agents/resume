#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Lattice has no local backing services to restart after an orb wakes. Keep this
# hook fast, but surface an incomplete setup clearly if a snapshot is damaged.
node_bin="$HOME/.local/share/node-v22/bin/node"
if [[ ! -x "$node_bin" ]]; then
  echo "Missing $node_bin; rerun .agents/setup." >&2
  exit 1
fi
synara_source="${SYNARA_SOURCE_DIR:-$("$node_bin" -p "require('./scripts/synara-runtime.json').sourceDirectory")}"
if [[ "$synara_source" != /* ]]; then
  synara_source="$repo_root/$synara_source"
fi

for path in \
  node_modules \
  collab-server/node_modules \
  "$synara_source/node_modules" \
  src-tauri/synara-runtime/manifest.json \
  "$HOME/.cargo/bin/cargo"; do
  if [[ ! -e "$path" ]]; then
    echo "Missing $path; rerun .agents/setup." >&2
    exit 1
  fi
done

echo "Orb dependencies are ready; no services need restarting."
