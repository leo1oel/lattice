# The Lingui catalogs are generated and sorted by message, so parallel branches
# that each add a string collide on adjacent lines. scripts/merge-po.mjs merges
# them entry by entry; register it once per clone with
# `node scripts/merge-po.mjs --install` (CONTRIBUTING.md). Unregistered, git
# falls back to its normal text merge.
src/locales/**/*.po merge=lingui-po

# Included shell scripts retain their LF syntax in Windows checkouts too.
*.sh text eol=lf

# scripts/check-file-size.mjs (the pre-commit size ratchet) skips generated and
# vendored files: venues.ts is regenerated by scripts/gen-venues.mjs, and the
# conference and thesis style files are copied unchanged from upstream (see
# each template's UPSTREAM.md).
src/papers/venues.ts linguist-generated
src-tauri/templates/*/*.sty linguist-vendored
src-tauri/templates/*/*.bst linguist-vendored
src-tauri/templates/*/*.cls linguist-vendored

# The design system's exported copy is generated from its Paper file by
# design-system/export.mjs (design-system/README.md); edit Paper, not these.
design-system/tokens.css linguist-generated
design-system/tokens.json linguist-generated
design-system/DESIGN.md linguist-generated
design-system/paper-export.json linguist-generated

# The GPUI app's patched upstream crates are upstream's source plus the diffs
# beside them (gpui/patches/README.md); script/check-patches keeps them so.
gpui/patches/gpui-fast/** linguist-vendored
gpui/patches/gpui-component/** linguist-vendored
gpui/patches/gpui-base/** linguist-vendored
