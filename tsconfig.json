{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias for shadcn/ui components (@/… -> src/…). */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ok-app/*": ["./src/open-knowledge-app/*"],
      "@ok-core": ["./src/open-knowledge-core/index.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `tools/` holds development-only pages (the animated-icon playground) that
  // are never a build input. They still import app modules, so they are
  // typechecked here — otherwise a rename in src/ could silently break them.
  "include": ["src", "tools"],
  // Vendored Open Knowledge core tests are written against upstream's looser
  // tsconfig and @tiptap 3.22 types; they run under vitest but are excluded
  // from app typechecking to avoid hand-editing vendored code.
  "exclude": [
    "src/open-knowledge-core/**/*.test.ts",
    "src/open-knowledge-core/**/*.test-helper.ts",
    "src/open-knowledge-core/markdown/fixtures/**",
    // Runs the compiler-report script through node:child_process; needs node
    // types the browser-targeted app tsconfig does not load. Vitest still
    // runs and typechecks it through its own transform.
    "src/platform/react-compiler-guard.test.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
