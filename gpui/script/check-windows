#!/usr/bin/env bash
# Type-check the app for x86_64-pc-windows-msvc on macOS.
#
# Rust code is fully checked (Zed's editor, gpui_windows, GPUI Kit, this
# app). C dependencies are not: without the Windows SDK their build scripts
# get a stand-in compiler that only creates empty objects, which `cargo
# check` never links. The dev profile is required because a release
# gpui_windows embeds shaders that only fxc.exe on a Windows host compiles.
# GPUI's build script compiles its Windows manifest with llvm-rc
# (`brew install llvm`).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tools="$(mktemp -d)"
trap 'rm -rf "$tools"' EXIT
for name in clang-cl llvm-lib lib.exe; do
  ln -s "$root/script/windows-check/fake-msvc-tool" "$tools/$name"
done

export CC_x86_64_pc_windows_msvc="$tools/clang-cl"
export CXX_x86_64_pc_windows_msvc="$tools/clang-cl"
export AR_x86_64_pc_windows_msvc="$tools/llvm-lib"
export PATH="$tools:$PATH"
if ! command -v llvm-rc >/dev/null; then
  for llvm in /opt/homebrew/opt/llvm/bin /usr/local/opt/llvm/bin; do
    [ -x "$llvm/llvm-rc" ] && export PATH="$PATH:$llvm" && break
  done
fi
command -v llvm-rc >/dev/null || { echo "check-windows: llvm-rc not found (brew install llvm)" >&2; exit 1; }

cd "$root"
cargo check --target x86_64-pc-windows-msvc -p lattice-gpui -p tex "$@"
