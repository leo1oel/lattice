#!/usr/bin/env bash
# Stand-in for clang-cl and lib.exe when type-checking the Windows target on
# macOS without the Windows SDK. `cargo check` never links, so the C objects
# build scripts produce only have to exist.
set -euo pipefail

args=()
for arg in "$@"; do
  if [[ "$arg" == @* && -f "${arg#@}" ]]; then
    # Response file: one argument per whitespace-separated word.
    read -r -a words < <(tr '\n' ' ' < "${arg#@}")
    args+=("${words[@]}")
  else
    args+=("$arg")
  fi
done

for arg in "${args[@]}"; do
  case "$arg" in
    --version|-v|/\?|-\?) echo "clang version 21.0.0"; echo "Target: x86_64-pc-windows-msvc"; exit 0 ;;
    -E|/E|-EP|/EP) exit 0 ;;
  esac
done

previous=""
for arg in "${args[@]}"; do
  out=""
  case "$arg" in
    -Fo?*) out="${arg#-Fo}" ;;
    /Fo?*) out="${arg#/Fo}" ;;
    -out:?*) out="${arg#-out:}" ;;
    /OUT:?*) out="${arg#/OUT:}" ;;
    /out:?*) out="${arg#/out:}" ;;
  esac
  if [[ "$previous" == "-o" ]]; then out="$arg"; fi
  if [[ -n "$out" && "$out" != */ ]]; then
    mkdir -p "$(dirname "$out")"
    : > "$out"
  fi
  previous="$arg"
done
