+/// lattice-gpui lab patch: with `GPUI_LAB_ASSUME_KEY` set, every window acts
+/// as the key window of the active app, as GPUI's test platforms make
+/// activation a flag: it reports itself active from the start and never
+/// resigns, so its focus, carets, blink and frame rate are a key window's,
+/// and neither activating a window nor the app takes the machine's front.
+/// Scripted runs set it so several can run side by side on one Mac, each
+/// with its events sent to its own window; what macOS itself serves only
+/// the real key window (the input method, a webview's keyboard focus, the
+/// menu bar's key equivalents) is not covered.
+pub(crate) fn lab_assumes_key() -> bool {
+    static ASSUME: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ASSUME.get_or_init(|| std::env::var_os("GPUI_LAB_ASSUME_KEY").is_some())
+}
